{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouthkind",
  "version": "1.0.0",
  "identifier": "au.com.gc.mouthkind",
  "build": {
    "frontendDist": "https://REPLACE-WITH-YOUR-SITE-URL/"
  },
  "app": {
    "windows": [
      {
        "title": "Mouthkind",
        "width": 480,
        "height": 900,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
